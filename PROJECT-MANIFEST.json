{
  "project": "Blue Bear Electric Website",
  "version": "9.5.0",
  "deployment": "Vercel static multi-page site with serverless API",
  "runtime": {
    "public_pages": [
      "about.html",
      "commercial.html",
      "contact.html",
      "engineering-inspection.html",
      "index.html",
      "industrial.html",
      "projects.html",
      "residential.html",
      "security-policy.html",
      "service-repair.html",
      "services.html",
      "solar-bess.html"
    ],
    "portal_pages": ["customer-portal.html", "employee-portal.html", "reset-password.html"],
    "admin_pages": ["admin-portal.html", "admin.html", "customize.html", "system-check.html"],
    "shared_site_config": "config/site.json",
    "shared_public_template": "src/templates/public-shell.mjs",
    "shared_html_generator": "scripts/build-shared-html.mjs",
    "javascript_directory": "assets/js",
    "stylesheets": ["style.css", "theme.css", "portal.css"],
    "api_directory": "api",
    "sql_directory": "supabase/migrations",
    "historical_sql_directory": "docs/sql",
    "javascript_inventory": "docs/JAVASCRIPT-INVENTORY.md"
  },
  "features": [
    "secure quote workflow",
    "admin portal",
    "retired customer portal redirect",
    "employee portal",
    "managed carousels",
    "individual photo slots",
    "engineering inspection division",
    "logo-only cinematic intro",
    "responsive production design system",
    "build-time shared public header and footer",
    "unique clean-route canonical metadata",
    "browser and app icon metadata",
    "document studio",
    "project command center"
  ],
  "archive_policy": "Historical release notes and legacy guides remain under docs/archive and docs/releases."
}
